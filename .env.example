# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: ephemeral-preview-environments
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - Dry-run preview environment reconciliation.
#
# TIER 2 / TIER 3: LIVE KUBERNETES & GITHUB WEBHOOKS
# - Point controller to real cluster and supply GitHub webhook secret.

GITHUB_WEBHOOK_SECRET=
BASE_DOMAIN=preview.example.com
MAX_AGE_HOURS=24
PORT=3000
